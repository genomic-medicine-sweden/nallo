nextflow_process {

    name "Test Process VEP_PREP_SV"
    script "../main.nf"
    process "VEP_PREP_SV"

    tag "modules"
    tag "modules_local"
    tag "vep_prep_sv"
    tag "sniffles"
    config "./nextflow.config"

    setup {
        run("SNIFFLES") {
            script "../../../../modules/nf-core/sniffles/main.nf"
            process {
                """
                input[0] = [
                    [id: 'HG002'],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                ]
                input[1] = [[],[]]
                input[2] = [[],[]]
                input[3] = true
                input[4] = false
                """
            }
        }
    }

    test("vep_prep_sv - sniffles1 synthetic") {

        when {
            params {
                caller = 'sniffles1'
            }
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/modules/local/vep_prep_sv/tests/input/snifflesv1.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def vcf_lines = path(process.out.vcf.get(0).get(1)).readLines()
            assertAll(
                { assert process.success },
                // STRANDBIAS filter header injected before first ##FILTER line
                { assert vcf_lines.any { it.startsWith('##FILTER=<ID=STRANDBIAS,') } },
                { assert vcf_lines.findIndexOf { it.startsWith('##FILTER=<ID=STRANDBIAS,') } <
                         vcf_lines.findIndexOf { it.startsWith('##FILTER=<ID=PASS,') } },
                // ORIG_SVTYPE INFO header added before #CHROM
                { assert vcf_lines.any { it.startsWith('##INFO=<ID=ORIG_SVTYPE,') } },
                // DEL: unchanged baseline — no ORIG_SVTYPE, END preserved
                { assert vcf_lines.any { it.contains('SVTYPE=DEL;') && !it.contains('ORIG_SVTYPE') } },
                // INS: synthetic END=POS stripped, SVTYPE unchanged
                { assert vcf_lines.any { it.contains('SVTYPE=INS') && !it.contains(';END=') } },
                // TRA → BND: SVLEN=1 stripped, END=190122450 (CHR2 coordinate) preserved
                { assert vcf_lines.any { it.contains('SVTYPE=BND') && it.contains(';END=190122450') &&
                                         it.contains('ORIG_SVTYPE=TRA') && !it.contains(';SVLEN=1') } },
                // DEL/INV → DEL
                { assert vcf_lines.any { it.contains('SVTYPE=DEL') && it.contains('ORIG_SVTYPE=DEL/INV') } },
                // INVDUP → DUP
                { assert vcf_lines.any { it.contains('SVTYPE=DUP') && it.contains('ORIG_SVTYPE=INVDUP') } },
                // DUP/INS → DUP: END=18788645 (source region) stripped
                { assert vcf_lines.any { it.contains('SVTYPE=DUP') && it.contains('ORIG_SVTYPE=DUP/INS') &&
                                         !it.contains(';END=') } },
                { assert snapshot(vcf_lines.join('\n'), process.out.versions_vep_prep_sv).match() }
            )
        }
    }

    test("vep_prep_sv - generic TRA remap (no caller flag)") {

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/modules/local/vep_prep_sv/tests/input/generic_tra.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def vcf_lines = path(process.out.vcf.get(0).get(1)).readLines()
            assertAll(
                { assert process.success },
                // generic remap fires without --caller flag
                { assert vcf_lines.count { it.contains('SVTYPE=BND') && it.contains('ORIG_SVTYPE=TRA') } == 2 },
                // no STRANDBIAS header injection (no sniffles1 flag)
                { assert !vcf_lines.any { it.startsWith('##FILTER=<ID=STRANDBIAS,') } },
                // Debreak: SVLEN=0 is not stripped (only SVLEN=1 is sniffles1-specific)
                { assert vcf_lines.any { it.contains('DB281') && it.contains('SVLEN=0') } },
                { assert snapshot(vcf_lines.join('\n'), process.out.versions_vep_prep_sv).match() }
            )
        }
    }

    test("vep_prep_sv - sniffles2 integration") {

        when {
            process {
                """
                input[0] = SNIFFLES.out.vcf
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions_vep_prep_sv,
                    // skip ##fileDate line (index 2) which changes each run
                    (path(process.out.vcf.get(0).get(1)).readLines()[0,1] + path(process.out.vcf.get(0).get(1)).readLines().drop(3)).join('\n').md5()
                ).match() }
            )
        }
    }

    test("vep_prep_sv - sniffles2 -stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = SNIFFLES.out.vcf
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
