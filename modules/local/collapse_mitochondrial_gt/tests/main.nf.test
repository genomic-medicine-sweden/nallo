nextflow_process {

    name "Test Process COLLAPSE_MITOCHONDRIAL_GT"
    script "../main.nf"
    process "COLLAPSE_MITOCHONDRIAL_GT"

    tag "modules"
    tag "modules_local"
    tag "collapse_mitochondrial_gt"
    config "./nextflow.config"

    test("collapse_mitochondrial_gt - synthetic") {

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/modules/local/collapse_mitochondrial_gt/tests/input/mitorsaw_synthetic.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def vcf_lines = path(process.out.vcf.get(0).get(1)).readLines()
            assertAll(
                { assert process.success },
                // all haplotypes REF -> 0/0, other FORMAT fields untouched
                { assert vcf_lines.any { it.startsWith('chrM\t100\t') && it.contains('0/0:30:30,0:0') } },
                // all haplotypes ALT -> 1/1
                { assert vcf_lines.any { it.startsWith('chrM\t200\t') && it.contains('1/1:30:0,30:1') } },
                // mixed (1 of 5 ALT) -> 0/1 (heteroplasmic, low VAF)
                { assert vcf_lines.any { it.startsWith('chrM\t300\t') && it.contains('0/1:30:24,6:0.2') } },
                // mixed (4 of 5 ALT) -> 0/1 (heteroplasmic, high VAF)
                { assert vcf_lines.any { it.startsWith('chrM\t400\t') && it.contains('0/1:30:6,24:0.8') } },
                // all haplotypes missing -> ./.
                { assert vcf_lines.any { it.startsWith('chrM\t500\t') && it.contains('./.:30:0,0:0') } },
                { assert snapshot(vcf_lines.join('\n'), process.out.versions_collapse_mitochondrial_gt).match() }
            )
        }
    }

    test("collapse_mitochondrial_gt - synthetic -stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/modules/local/collapse_mitochondrial_gt/tests/input/mitorsaw_synthetic.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
