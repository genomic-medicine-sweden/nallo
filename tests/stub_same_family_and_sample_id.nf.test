nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub tests for samplesheet with family id identical to sample id"
    script "../main.nf"
    tag "PIPELINE"
    tag "pipeline_stub"
    tag "stub_same_family_and_sample_id"
    config "./nextflow.config"

    test("Test family id same as sample id") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/c79f183c64070edac47873024df024aaf4b6c42b/'
                input                        = "$projectDir/assets/samplesheet_same_sample_and_family_id.csv"
                outdir                       = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }
}
