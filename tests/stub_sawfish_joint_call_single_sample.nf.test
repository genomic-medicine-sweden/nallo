nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub tests for single sample sawfish joint calling"
    script "../main.nf"
    tag "PIPELINE"
    tag "pipeline_stub"
    tag "stub_sawfish_joint_call_single_sample"
    config "./nextflow.config"

    test("Test sawfish with force_sawfish_joint_call_single_samples true") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path            = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/59c411038dac1e4dab2d745c80d382f047433539/'
                input                                   = "$projectDir/assets/samplesheet.csv"
                outdir                                  = "$outputDir"
                skip_annotate_paralogs                  = true
                skip_call_paralogs                      = true
                skip_chromograph                        = true
                skip_methylation_calling                = true
                skip_methylation_annotation             = true
                skip_peddy                              = true
                skip_phasing                            = true
                skip_rank_variants                      = true
                skip_repeat_annotation                  = true
                skip_repeat_calling                     = true
                skip_snv_annotation                     = true
                skip_sv_annotation                      = true
                sv_callers_to_run                       = "sawfish"
                sv_callers_to_merge                     = "sawfish"
                sv_callers_merge_priority               = "sawfish"
                force_sawfish_joint_call_single_samples = true
                skip_prepare_gens_input                 = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('SVDB_MERGE_BY_FAMILY') },
                { assert versions.containsKey('SAWFISH_DISCOVER') },
                { assert versions.containsKey('SAWFISH_JOINTCALL') },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }
}
