nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub test for ONT_R10 methylation annotation"
    script "../main.nf"
    tag "PIPELINE"
    tag "pipeline_stub"
    tag "stub_ont_r10_methylation_annotation"
    config "./nextflow.config"

    test("ONT_R10 preset with default methylation annotation settings") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ont_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "ONT_R10"
                // Null out params with exists:true that are not needed for this test
                sv_call_regions              = null
                gens_panel_of_normals_female = null
                gens_panel_of_normals_male   = null
                // Skip steps irrelevant to methylation annotation
                skip_genome_assembly         = true
                skip_portello                = true
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_peddy                   = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_snv_annotation          = true
            }
        }

        then {
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('MODKIT_PILEUP') },           // modkit runs for ONT_R10
                { assert !versions.containsKey('METHBAT_PROFILE') },         // methbat does not run for ONT_R10
                { assert versions.containsKey('GAWK_REGION_GENES') },       // methylation annotation runs for modkit
                { assert versions.containsKey('GAWK_DMR_REGIONS') },        // methylation_regions converted for modkit dmr
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                ).match() }
            )
        }
    }

    test("ONT_R10 preset without methylation_regions fails with informative error") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ont_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "ONT_R10"
                // Null out params with exists:true that are not needed for this test
                sv_call_regions              = null
                gens_panel_of_normals_female = null
                gens_panel_of_normals_male   = null
                // Skip steps irrelevant to methylation annotation
                skip_genome_assembly         = true
                skip_portello                = true
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_peddy                   = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_snv_annotation          = true
                methylation_regions          = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("--skip_methylation_annotation is NOT active, the following files are required: --methylation_regions") } }
            )
        }
    }

    test("ONT_R10 preset without methbat_map fails with informative error") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ont_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "ONT_R10"
                // Null out params with exists:true that are not needed for this test
                sv_call_regions              = null
                gens_panel_of_normals_female = null
                gens_panel_of_normals_male   = null
                // Skip steps irrelevant to methylation annotation
                skip_genome_assembly         = true
                skip_portello                = true
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_peddy                   = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_snv_annotation          = true
                methbat_map                  = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("--methbat_map must be provided when running without --skip_methylation_annotation") } }
            )
        }
    }

    test("ONT_R10 preset with only HGNC:NA region labels fails with informative error") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ont_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "ONT_R10"
                // Null out params with exists:true that are not needed for this test
                sv_call_regions              = null
                gens_panel_of_normals_female = null
                gens_panel_of_normals_male   = null
                // Skip steps irrelevant to methylation annotation
                skip_genome_assembly         = true
                skip_portello                = true
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_peddy                   = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_snv_annotation          = true
                methylation_regions          = 'https://raw.githubusercontent.com/aksenia/test-datasets/da523b48f6fdc7e8ac58c169f8449c065d8f49b4/testdata/methylation_regions_hgnc_na.tsv'
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("--methylation_regions needs a header with `chrom`, `start` and `end`, and at least one region whose label is not `HGNC:NA`") } }
            )
        }
    }

    test("ONT_R10 preset with skip_phasing fails with informative error") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ont_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "ONT_R10"
                // Null out params with exists:true that are not needed for this test
                sv_call_regions              = null
                gens_panel_of_normals_female = null
                gens_panel_of_normals_male   = null
                // Skip steps irrelevant to methylation annotation
                skip_genome_assembly         = true
                skip_portello                = true
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_peddy                   = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_snv_annotation          = true
                skip_phasing                 = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("--skip_phasing is active") && line.contains("--skip_methylation_annotation") } }
            )
        }
    }

}
