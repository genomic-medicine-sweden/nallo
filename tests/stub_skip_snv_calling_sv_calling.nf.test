nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub tests for SV calling with skip_snv_calling"
    script "../main.nf"
    tag "PIPELINE"
    tag "pipeline_stub"
    tag "stub_skip_snv_calling_sv_calling"
    config "./nextflow.config"

    test("All SV callers run with skip_snv_calling and create_maf_track false") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_fastq.csv"
                outdir                       = "$outputDir"
                skip_annotate_paralogs       = true
                skip_call_paralogs           = true
                skip_chromograph             = true
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_mitochondrial_calling   = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_repeat_calling          = true
                skip_snv_annotation          = true
                skip_snv_calling             = true
                skip_sv_annotation           = true
                sv_callers_to_run            = "sniffles,sniffles1,severus,debreak,hificnv,sawfish"
                create_maf_track             = false
                // skip_portello for fastq input
                skip_portello                = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('RUN_SNIFFLES') },
                { assert versions.containsKey('RUN_SNIFFLES1') },
                { assert versions.containsKey('RUN_SEVERUS') },
                { assert versions.containsKey('RUN_DEBREAK') },
                { assert versions.containsKey('RUN_HIFICNV') },
                { assert versions.containsKey('RUN_SAWFISH_DISCOVER') },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }

    test("HiFiCNV with skip_snv_calling and the MAF track on fails with informative error") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_fastq.csv"
                outdir                       = "$outputDir"
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_prepare_gens_input      = true
                skip_rank_variants           = true
                skip_repeat_annotation       = true
                skip_repeat_calling          = true
                skip_snv_annotation          = true
                skip_snv_calling             = true
                sv_callers_to_run            = "hificnv"
                // skip_portello for fastq input
                skip_portello                = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("The HiFiCNV MAF track requires SNV calling") } }
            )
        }
    }

}
