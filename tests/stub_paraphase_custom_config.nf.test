nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub test for paraphase custom config validation"
    script "../main.nf"
    tag "PIPELINE"
    tag "stub_paraphase_custom_config"
    config "./nextflow.config"

    test("revio preset with custom paraphase config file") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/8cf6216b9cbf96f6bcfc918610182708e3796ad9/'
                input                        = "$projectDir/assets/samplesheet_multisample_ubam.csv"
                outdir                       = "$outputDir"
                preset                       = "revio"
                paraphase_config             = file('../../../assets/multiqc_config.yaml', checkIfExists: true)
                paraphrase_output_format     = 'json'
                skip_genome_assembly         = true
                skip_portello                = true
                skip_rank_variants           = true
                alignment_processes          = 1
                skip_snv_calling             = true
                skip_snv_annotation          = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_repeat_calling          = true
                skip_repeat_annotation       = true
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_prepare_gens_input      = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }

}
