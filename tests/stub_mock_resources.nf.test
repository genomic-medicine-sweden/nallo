nextflow_pipeline {

    name "Test pipeline GENOMICMEDICINESWEDEN_NALLO — Stub tests for CADD, VEP uncompressed cache and Sentieon SNV calling with mock resources"
    script "../main.nf"
    tag "PIPELINE"
    tag "pipeline_stub"
    tag "stub_mock_resources"
    config "./nextflow.config"

    test("Test CADD with mock resources") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/cc5e1a9a8e9c4d46176055ba752aa0764aec7147/'
                input                        = "$projectDir/assets/samplesheet.csv"
                outdir                       = "$outputDir"
                // Mock inputs for CADD
                cadd_resources               = "$projectDir/assets"
                cadd_prescored_indels        = "$projectDir/docs"
                // Skip irrelevant steps
                skip_annotate_paralogs       = true
                skip_chromograph             = true
                skip_genome_assembly         = true
                skip_call_paralogs           = true
                skip_qc                      = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_rank_variants           = true
                skip_repeat_calling          = true
                skip_repeat_annotation       = true
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_prepare_gens_input      = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('CADD') },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }

    test("Test VEP with mock uncompressed cache") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/cc5e1a9a8e9c4d46176055ba752aa0764aec7147/'
                input                        = "$projectDir/assets/samplesheet.csv"
                outdir                       = "$outputDir"
                // Mock inputs for VEP
                vep_cache                    = "$projectDir/assets"
                // Skip irrelevant steps
                skip_annotate_paralogs       = true
                skip_chromograph             = true
                skip_genome_assembly         = true
                skip_call_paralogs           = true
                skip_qc                      = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_rank_variants           = true
                skip_repeat_calling          = true
                skip_repeat_annotation       = true
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_prepare_gens_input      = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('ENSEMBLVEP_SNV') },
                { assert !versions.containsKey('UNTAR_VEP_CACHE') },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }

    test("Test Sentieon SNV calling with mock resources") {
        options "-stub"

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/genomic-medicine-sweden/test-datasets/cc5e1a9a8e9c4d46176055ba752aa0764aec7147/'
                input                        = "$projectDir/assets/samplesheet.csv"
                outdir                       = "$outputDir"
                snv_caller                   = "sentieon"
                snv_calling_processes        = 1

                // Mock resources
                sentieon_model_bundle        = params.pipelines_testdata_base_path + 'reference/test_data.bed'
                sentieon_female_diploid_bed  = params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XX.bed'
                sentieon_male_diploid_bed    = params.pipelines_testdata_base_path + 'reference/empty.bed'
                sentieon_male_haploid_bed    = params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XY.bed'
                // Skip irrelevant steps
                skip_annotate_paralogs       = true
                skip_chromograph             = true
                skip_genome_assembly         = true
                skip_call_paralogs           = true
                skip_qc                      = true
                skip_sv_calling              = true
                skip_sv_annotation           = true
                skip_peddy                   = true
                skip_phasing                 = true
                skip_rank_variants           = true
                skip_repeat_calling          = true
                skip_repeat_annotation       = true
                skip_methylation_calling     = true
                skip_methylation_annotation  = true
                skip_prepare_gens_input      = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def versions = removeNextflowVersion("$outputDir/pipeline_info/nallo_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert versions.containsKey('BEDTOOLS_INTERSECT') },
                { assert versions.containsKey('DNASCOPE_LONGREAD') },
                { assert versions.containsKey('SENTIEON_GVCFTYPER') },
                { assert !versions.containsKey('GLNEXUS') },
                { assert !versions.containsKey('DEEPVARIANT_RUNDEEPVARIANT') },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    versions,
                    stable_name
                ).match() }
            )
        }
    }
}
