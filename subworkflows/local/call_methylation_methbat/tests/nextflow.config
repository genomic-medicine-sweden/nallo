process {
    withName: 'CALL_METHYLATION_METHBAT:PBCPGTOOLS_ALIGNEDBAMTOCPGSCORES' {
        ext.prefix = { "${meta.id}_pbcpgtools" }
    }
    withName: 'PHASING:LONGPHASE:BCFTOOLS_INDEX' {
        ext.args = '--tbi'
    }
    withName: 'PHASING:LONGPHASE:BCFTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_phased_${meta.variant_type}" }
        ext.args   = ['--output-type z', '--write-index=tbi', '--no-version', '--force-single'].join(' ')
    }
    withName: 'PHASING:LONGPHASE:LONGPHASE_PHASE' {
        ext.prefix = { "${meta.id}_phased" }
        ext.args   = ['--pb', '--indels'].join(' ')
    }
    withName: 'PHASING:LONGPHASE:LONGPHASE_HAPLOTAG' {
        ext.prefix = { "${meta.id}_haplotagged" }
    }
    withName: 'PHASING:LONGPHASE:SPLIT_MULTISAMPLE_VCF:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}.${meta.variant_type}" }
        ext.args   = {
            ['--output-type z', '--no-version', "--samples ${meta.id}"].join(' ')
        }
    }
    // One row per region (and data_category), labelled chrom:start-end
    withName: 'CALL_METHYLATION_METHBAT:GAWK_METHBAT_REGIONS' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = [
            '\'{ sub(/\\r$/, "") }',
            'FNR == 1 && $1 == "chrom" { for (i = 4; i <= NF; i++) { if ($i == "cpg_label" || $i == "region_label") label = i; if ($i == "data_category") category = i }; print; next }',
            '{ key = $1 OFS $2 OFS $3 OFS (category ? $category : ""); if (key in seen) next; seen[key] = 1; if (label) $label = $1 ":" $2 "-" $3; print }\'',
        ].join(' ')
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}_methbat_regions" }
    }

    withName: 'CALL_METHYLATION_METHBAT:METHBAT_PROFILE' {
        ext.args   = params.extra_methbat_profile_args
        ext.prefix = { "${meta.id}_methbat_profile" }
    }
}
