    test("2 samples, 1 family - sniffes,severus with trf bed, run all callers - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = MINIMAP2_ALIGN.out.bam
                    .join(MINIMAP2_ALIGN.out.index)
                input[1] = channel.of([
                    [ id:'trf' ],
                    file('https://github.com/fritzsedlazeck/Sniffles/raw/master/annotations/human_GRCh38_no_alt_analysis_set.trf.bed', checkIfExists: true)
                ]).collect()
                input[2] = DEEPVARIANT_RUNDEEPVARIANT.out.vcf
                input[3] = GUNZIP.out.gunzip
                input[4] = channel.of([
                    [ id: 'xy_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XY.bed', checkIfExists: true)
                ]).collect()
                input[5] = channel.of([
                    [ id: 'xx_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XX.bed', checkIfExists: true)
                ]).collect()
                input[6] = channel.of([
                    [ id: 'exclude_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/cnv.excluded_regions.hg38.bed.gz', checkIfExists: true)
                ]).collect()
                input[7] = ['sniffles', 'severus', 'hificnv']
                input[8] = [[],[]]
                input[9] = false
                input[10] = false
                input[11] = true
                input[12] = true
                input[13] = file('../../../assets/vcf_express_found_in_prelude.lua')
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // groupTuple's order within workflow.out.vcf isn't guaranteed when multiple
                    // samples' processes can finish in any order, so sort the grouped file names.
                    vcf: workflow.out.vcf.collect { meta, vcfs -> [meta, vcfs.collect { vcf -> file(vcf) }.sort { it.name }] },
                    hificnv_depth: workflow.out.hificnv_depth,
                    hificnv_copynum: workflow.out.hificnv_copynum,
                    hificnv_maf: workflow.out.hificnv_maf,
                    sawfish_depth_bw: workflow.out.sawfish_depth_bw,
                    sawfish_copynum_bedgraph: workflow.out.sawfish_copynum_bedgraph,
                    sawfish_gc_bias_corrected_depth_bw: workflow.out.sawfish_gc_bias_corrected_depth_bw,
                    sawfish_maf_bw: workflow.out.sawfish_maf_bw,
                ).match() }
            )
        }
    }

    test("1 sample, 1 family - sawfish, force_sawfish_joint_call_single_samples true -stub") {

