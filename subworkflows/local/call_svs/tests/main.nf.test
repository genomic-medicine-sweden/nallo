                input[2] = DEEPVARIANT_RUNDEEPVARIANT.out.vcf
                    .filter { meta, vcf -> meta.id == 'test_1' }
                input[3] = GUNZIP.out.gunzip
                input[4] = channel.of([
                    [ id: 'xy_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XY.bed', checkIfExists: true)
                ]).collect()
                input[5] = channel.of([
                    [ id: 'xx_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XX.bed', checkIfExists: true)
                ]).collect()
                input[6] = channel.of([
                    [ id: 'exclude_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/cnv.excluded_regions.hg38.bed.gz', checkIfExists: true)
                ]).collect()
                input[7] = ['sawfish']
                input[8] = true
                input[9] = true
                input[10] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.sv_calls
                        .findAll { meta, _vcf, _tbi -> meta.skip_vep_prep }
                        .collect { meta, vcf, tbi -> [
                            'sv_calls_indexed:',
                            meta,
                            // nft-vcf's codec only supports up to VCFv4.3, so we can't inspect variants for
                            // Sawfish VCFs (VCFv4.4) here - just check the file name.
