                input[4] = channel.of([
                    [ id: 'xy_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XY.bed', checkIfExists: true)
                ]).collect()
                input[5] = channel.of([
                    [ id: 'xx_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XX.bed', checkIfExists: true)
                ]).collect()
                input[6] = channel.of([
                    [ id: 'exclude_bed' ],
                    file(params.pipelines_testdata_base_path + 'reference/cnv.excluded_regions.hg38.bed.gz', checkIfExists: true)
                ]).collect()
                input[7] = ['sawfish']
                input[8] = channel.of('chr16\t160752\t160753')
                    .collectFile(name: "one_variant.bed")
                    .map { file ->
                        [ [ id: 'one_variant' ], file ]
                    }.collect()
                input[9] = false
                input[10] = true
                input[11] = true
                input[12] = true
                input[13] = file('../../../assets/vcf_express_found_in_prelude.lua')
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf
                        .collect { meta, vcfs -> [
                            'vcf:',
                            meta,
                            // nft-vcf's codec only supports up to VCFv4.3, so we can't inspect variants for
                            // HiFiCNV/Sawfish VCFs (VCFv4.4) here - just check the file name for those.
