process {

    withName: 'ALIGN:MINIMAP2_INDEX' {
        ext.args = { "-x map-hifi" }
    }

    withName: 'ALIGN:MINIMAP2_ALIGN' {
        ext.prefix = { "${reads}" }
        ext.args   = {
            [
                "-y",
                "-x map-hifi",
                "--secondary=no",
                "-Y",
                "-R @RG\\\\tID:${meta.id}\\\\tSM:${meta.id}",
                "--MD",
            ].join(' ')
        }
        ext.args3  = {
            [
                '-x HP,PS',
                '-x AS,CC,CG,CP,H1,H2,HI,H0,IH,MC,MD,MQ,NM,SA,TS',
                '--no-RG',
            ].join(' ')
        }
        ext.args4  = '-T \\*'
    }

    withName: 'ALIGN:PBMM2_ALIGN' {
        ext.prefix = { "${meta.id}_aligned_reads_no_md" }
        ext.args   = {
            [
                "--sort",
                "--preset ${params.pbmm2_preset}",
                "--unmapped",
                "--sample ${meta.id}",
            ].join(' ')
        }
    }
}
