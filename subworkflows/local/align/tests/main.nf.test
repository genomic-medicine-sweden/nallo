nextflow_workflow {

    name "Test Subworkflow ALIGN"
    script "../main.nf"
    workflow "ALIGN"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/align"
    tag "minimap2"
    tag "minimap2/align"
    tag "samtools"
    tag "samtools/merge"
    tag "splitubam"

    test("[fastq, fasta, false]") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.fastq.gz', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(bam(workflow.out.bam_bai.get(0).get(1)).getReadsMD5()).match() }
            )
        }
    }

    test("[bam, fasta, true]") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(bam(workflow.out.bam_bai.get(0).get(1)).getReadsMD5()).match() }
            )
        }
    }

    test("[bam, fasta, true] - different IDs") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam_bai.get(0).get(1)).getReadsMD5(),
                    bam(workflow.out.bam_bai.get(1).get(1)).getReadsMD5()
                ).match() }
            )
        }
    }

    test("[bam, fasta, true] - same ID") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(bam(workflow.out.bam_bai.get(0).get(1)).getReadsMD5()).match() }
            )
        }

    }

    test("[fastq, fasta, false] - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.fastq.gz', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta, true] - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta, true] - different IDs - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta, true] - same ID - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
