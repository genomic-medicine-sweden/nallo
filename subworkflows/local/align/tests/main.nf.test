nextflow_workflow {

    name "Test Subworkflow ALIGN"
    script "../main.nf"
    workflow "ALIGN"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/align"
    tag "minimap2"
    tag "minimap2/align"
    tag "minimap2/index"

    test("[bam, fasta]") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam.get(0).get(1)).getReadsMD5(),
                    file(workflow.out.index.get(0).get(1)).name
                ).match() }
            )
        }
    }

    test("[bam x 2, fasta] - different IDs") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    tuple(
                        [ id:'test' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                    ),
                    tuple(
                        [ id:'test2' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true)
                    )
                )
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam.get(0).get(1)).getReadsMD5(),
                    bam(workflow.out.bam.get(1).get(1)).getReadsMD5(),
                    file(workflow.out.index.get(0).get(1)).name,
                    file(workflow.out.index.get(1).get(1)).name
                ).match() }
            )
        }
    }

    test("[bam, fasta] - same ID") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    tuple(
                        [ id:'test' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                    ),
                    tuple(
                        [ id:'test' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                    )
                )
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam.get(0).get(1)).getReadsMD5(),
                    file(workflow.out.index.get(0).get(1)).name
                ).match() }
            )
        }

    }

    test("[fastq, fasta] - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.fastq.gz', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta] - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta] - different IDs - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("[bam, fasta] - same ID - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                ])
                input[1] = [ [ id: 'hg38'], params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
