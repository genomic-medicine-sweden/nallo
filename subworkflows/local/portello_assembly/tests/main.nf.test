nextflow_workflow {

    name "Test Workflow PORTELLO_ASSEMBLY"
    script "../main.nf"
    workflow "PORTELLO_ASSEMBLY"
    config "./nextflow.config"

    setup {
        run("PREPARE_REFERENCES") {
            script "../../prepare_references/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = true
                input[4] = false
                """
            }
        }

        run("GENOME_ASSEMBLY") {
            script "../../genome_assembly/main.nf"
            process {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', sex: 1  ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.fastq.gz', checkIfExists: true)
                    ]
                )
                input[1] = false
                """
            }
        }

        run("ALIGN_ASSEMBLIES") {
            script "../../align_assemblies/main.nf"
            process {
                """
                input[0] = GENOME_ASSEMBLY.out.assembled_haplotypes
                input[1] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = false
                """
            }
        }
    }

    test("1 sample") {
        when {
            workflow {
                """
                input[0] = GENOME_ASSEMBLY.out.assembled_haplotypes
                input[1] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[2] = ALIGN_ASSEMBLIES.out.bam
                                .join(ALIGN_ASSEMBLIES.out.bai, failOnMismatch: true, failOnDuplicate: true)
                input[3] = PREPARE_REFERENCES.out.fasta
                input[4] = PREPARE_REFERENCES.out.fai
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam.get(0).get(1)).getReadsMD5(),
                    file(workflow.out.bai.get(0).get(1)).name
                ).match() }
            )
        }
    }

    test("1 sample - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = GENOME_ASSEMBLY.out.assembled_haplotypes
                input[1] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ])
                input[2] = ALIGN_ASSEMBLIES.out.bam
                                .join(ALIGN_ASSEMBLIES.out.bai, failOnMismatch: true, failOnDuplicate: true)
                input[3] = PREPARE_REFERENCES.out.fasta
                input[4] = PREPARE_REFERENCES.out.fai
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
