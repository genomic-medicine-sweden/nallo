nextflow_workflow {

    name "Test Workflow PORTELLO_ASSEMBLY"
    script "../main.nf"
    workflow "PORTELLO_ASSEMBLY"

    setup {
        run("PREPARE_REFERENCES") {
            script "../../prepare_references/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = []
                input[2] = [
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ]
                input[3] = true
                input[4] = true
                """
            }
        }

        run("GENOME_ASSEMBLY") {
            script "../../genome_assembly/main.nf"
            process {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', sex: 1  ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.fastq.gz', checkIfExists: true)
                    ]
                )
                input[1] = false
                """
            }
        }

        run("MINIMAP2_ALIGN") {
            script "../../../../modules/nf-core/minimap2/align/main.nf"
            process {
                """
                input[0] = GENOME_ASSEMBLY.out.assembled_haplotypes
                                .map { meta, bam -> [meta - meta.subMap('haplotype'), bam] }
                                .groupTuple(size: 2)
                input[1] = PREPARE_REFERENCES.out.mmi.collect()
                input[2] = true
                input[3] = 'bai'
                input[4] = false
                input[5] = false
                """
            }
        }
    }

    test("1 sample") {
        when {
            workflow {
                """
                input[0] = GENOME_ASSEMBLY.out.assembled_haplotypes
                input[1] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam'),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam.bai'),
                ])
                input[3] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[4] = PREPARE_REFERENCES.out.fai
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                //{ assert snapshot(workflow.out).match() }
            )
        }
    }
