process {

    withName: 'PORTELLO_ASSEMBLY:PORTELLO' {
        ext.prefix = { "${meta.id}_remapped_assembly_no_tag" }
    }

    withName: 'PORTELLO_ASSEMBLY:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}_remapped_assembly_sorted" }
    }

    withName: 'PORTELLO_ASSEMBLY:SAMTOOLS_ADDREPLACERG' {
        ext.prefix = { "${meta.id}_remapped_assembly_rg" }
    }

    withName: 'PORTELLO_ASSEMBLY:SAMTOOLS_CALMD' {
        ext.prefix = { "${meta.id}_remapped_assembly_md" }
        ext.args   = '-b '
    }

    withName: 'PORTELLO_ASSEMBLY:GATK4_CLEANSAM' {
        ext.prefix = { "${meta.id}_remapped_assembly" }
    }

    withName: 'PORTELLO_ASSEMBLY:SAMTOOLS_INDEX' {
        ext.prefix = { "${meta.id}_remapped_assembly" }
    }
}
