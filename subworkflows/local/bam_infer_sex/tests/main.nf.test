nextflow_workflow {

    name "Test Subworkflow BAM_INFER_SEX"
    script "../main.nf"
    workflow "BAM_INFER_SEX"

    setup {
        run("PREPARE_REFERENCES") {
            script "../../../../subworkflows/local/prepare_references/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[2] = true
                input[3] = false
                """
            }
        }

        run("MINIMAP2_ALIGN") {
            script "../../../../modules/nf-core/minimap2/align/main.nf"
            process {
                """
                input[0] = [
                    [ id:'HG002', family_id:'family', paternal_id:0, maternal_id:0, phenotype:2, project:'project', n_files:1, single_end:true ],
                    file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true)
                ]
                input[1] = PREPARE_REFERENCES.out.mmi
                input[2] = true
                input[3] = 'bai'
                input[4] = false
                input[5] = false
                """
            }
        }


        run("CREATE_PEDIGREE_FILE") {
            script "../../../../modules/local/create_pedigree_file/main.nf"
            process {
                """
                input[0] = channel.of(
                    [ [ id: 'project' ],
                    [
                        [id:'HG002', family_id:'family', paternal_id:0, maternal_id:0, sex:0, phenotype:2, project:'project', n_files:1, single_end:true]
                    ]
                ])
                """
            }
        }
    }


    test("[bam, bai], fasta, fai, somalier_sites, ped - 1 sample") {
        config "./nextflow.config"

        when {
            workflow {
                """
                input[0] = MINIMAP2_ALIGN.out.bam.join(MINIMAP2_ALIGN.out.index).map { meta, bam, bai ->
                    [ meta + [sex:1], bam, bai ]
                }
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("[bam, bai], fasta, fai, somalier_sites, ped - unknown sex") {
        config "./unknown_sex.config"

        when {
            workflow {
                """
                input[0] = MINIMAP2_ALIGN.out.bam.join(MINIMAP2_ALIGN.out.index).map { meta, bam, bai ->
                    [ meta + [sex:0], bam, bai ]
                }
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("[bam, bai], fasta, fai, somalier_sites, ped - stub") {

        options '-stub'

        when {
            workflow {
                """
                input[0] = MINIMAP2_ALIGN.out.bam.join(MINIMAP2_ALIGN.out.index).map { meta, bam, bai ->
                    [ meta + [sex:1], bam, bai ]
                }
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

        test("[bam, bai], fasta, fai, somalier_sites, ped - stub unknown sex") {

        options '-stub'

        when {
            workflow {
                """
                input[0] = MINIMAP2_ALIGN.out.bam.join(MINIMAP2_ALIGN.out.index).map { meta, bam, bai ->
                    [ meta + [sex:0], bam, bai ]
                }
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

}
