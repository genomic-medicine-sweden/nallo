nextflow_workflow {

    name "Test Subworkflow BAM_INFER_SEX"
    script "../main.nf"
    workflow "BAM_INFER_SEX"
    config "./nextflow.config"

    setup {
        run("PREPARE_REFERENCES") {
            script "../../../../subworkflows/local/prepare_references/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[2] = true
                input[3] = false
                """
            }
        }

        run("CREATE_PEDIGREE_FILE") {
            script "../../../../modules/local/create_pedigree_file/main.nf"
            process {
                """
                input[0] = channel.of(
                    [ [ id: 'test' ],
                    [
                        [id:'HG003', family_id:'FAM', paternal_id:0, maternal_id:0, sex:1, phenotype:1, project:'test', single_end:true, relationship:'father', two_parents:false, children:['HG002', 'HG002'], has_other_parent:true],
                        [id:'HG002', family_id:'FAM', paternal_id:'HG003', maternal_id:'HG004', sex:0, phenotype:2, project:'test', single_end:true, relationship:'child', two_parents:true, children:[], has_other_parent:false],
                        [id:'HG004', family_id:'FAM', paternal_id:0, maternal_id:0, sex:2, phenotype:1, project:'test', single_end:true, relationship:'mother', two_parents:false, children:['HG002', 'HG002'], has_other_parent:true]
                    ]
                ])
                """
            }
        }
    }


    test("[bam, bai], fasta, fai, somalier_sites, ped - 1 sample with unknown sex") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', family_id:'FAM', paternal_id:'HG004', sex:0, maternal_id:'HG003', phenotype:2, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                    ]
                )
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("[bam, bai], fasta, fai, somalier_sites, ped - multiple samples") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', family_id:'FAM', paternal_id:'HG004', sex:0, maternal_id:'HG003', phenotype:2, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG003', family_id:'FAM', paternal_id:0, maternal_id:0, sex:2, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG004', family_id:'FAM', paternal_id:0, maternal_id:0, sex:1, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                )
                input[1] = PREPARE_REFERENCES.out.fasta.collect()
                input[2] = PREPARE_REFERENCES.out.fai.collect()
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ]).collect()
                input[4] = CREATE_PEDIGREE_FILE.out.ped.collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("[bam, bai], fasta, fai, somalier_sites, ped - stub") {

        options '-stub'

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG003', family_id:'FAM', paternal_id:0, maternal_id:0, sex:2, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam.bai', checkIfExists: true)
                    ]
                )
                input[1] = PREPARE_REFERENCES.out.fasta
                input[2] = PREPARE_REFERENCES.out.fai
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ])
                input[4] = CREATE_PEDIGREE_FILE.out.ped
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

        test("[bam, bai], fasta, fai, somalier_sites, ped - stub unknown sex") {

        options '-stub'

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', family_id:'FAM', paternal_id:'HG004', sex:0, maternal_id:'HG003', phenotype:2, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
