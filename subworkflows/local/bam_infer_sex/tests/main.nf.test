        test("[bam, bai], fasta, fai, somalier_sites, ped - stub multiple samples") {

        options '-stub'

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', family_id:'FAM', paternal_id:'HG004', sex:1, maternal_id:'HG003', phenotype:2, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG003', family_id:'FAM', paternal_id:0, maternal_id:0, sex:2, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG004', family_id:'FAM', paternal_id:0, maternal_id:0, sex:1, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                )
                input[1] = PREPARE_REFERENCES.out.fasta.collect()
                input[2] = PREPARE_REFERENCES.out.fai.collect()
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ]).collect()
                input[4] = CREATE_PEDIGREE_FILE.out.ped.collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("[bam, bai], fasta, fai, somalier_sites, ped - stub multiple samples, all unknown sex") {
        options '-stub'

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'HG002', family_id:'FAM', paternal_id:'HG004', sex:0, maternal_id:'HG003', phenotype:2, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG003', family_id:'FAM', paternal_id:0, maternal_id:0, sex:0, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id: 'HG004', family_id:'FAM', paternal_id:0, maternal_id:0, sex:0, phenotype:1, project:'test', n_files:1, single_end:true ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG004_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                )
                input[1] = PREPARE_REFERENCES.out.fasta.collect()
                input[2] = PREPARE_REFERENCES.out.fai.collect()
                input[3] = channel.of([
                    [ 'id': 'somalier_sites' ],
                    file(params.pipelines_testdata_base_path + 'reference/somalier_sites.vcf.gz', checkIfExists: true)
                ]).collect()
                input[4] = CREATE_PEDIGREE_FILE.out.ped.collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match()}
            )
        }
    }

}
