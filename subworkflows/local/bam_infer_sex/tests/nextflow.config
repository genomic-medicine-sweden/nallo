params {
    min_depth = ""
    min_ab    = ""
}

process {
    withName: 'BAM_INFER_SEX:RELATE_RELATE' {
        ext.args = '--infer'
    }

    withName: 'BAM_INFER_SEX:RELATE_INFER' {
        ext.args = { [
            '--infer',
            params.min_depth,
            params.min_ab
        ].join(' ') }
    }

}
