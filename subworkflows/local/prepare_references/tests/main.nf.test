nextflow_workflow {

    name "Test Workflow PREPARE_REFERENCES"
    script "../main.nf"
    config "./nextflow.config"
    workflow "PREPARE_REFERENCES"

    setup {
        run("GUNZIP") {
            script "../../../../modules/nf-core/gunzip/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ]
                """
            }

        }
        run("SAMTOOLS_FAIDX") {
            script "../../../../modules/nf-core/samtools/faidx/main.nf"
            process {
                """
                input[0] = GUNZIP.out.gunzip.map { meta, fasta -> [meta, fasta, []] }
                input[1] = false
                """
            }
        }
    }

    test("unzip fasta, untar vep cache") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = true
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

        test("unzip fasta, fai, untar vep cache") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = SAMTOOLS_FAIDX.out.fai
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = true
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().find { it.name.contains('PREPARE_REFERENCES:SAMTOOLS_FAIDX') } == null },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("don't unzip fasta, untar vep cache") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa', checkIfExists: true)
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = false
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("unzip fasta, untar vep cache -stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = true
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("unzip fasta, fai, untar vep cache -stub") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa.gz', checkIfExists: true)
                ])
                input[1] = SAMTOOLS_FAIDX.out.fai
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = true
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().contains("SAMTOOLS_FAIDX") == false },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("don't unzip fasta, don't untar vep cache -stub") {

        options "-stub"
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.pipelines_testdata_base_path + 'reference/hg38.test.fa', checkIfExists: true)
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file("$projectDir/.devcontainer", checkIfExists:true)
                ])
                input[3] = false
                input[4] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

}
