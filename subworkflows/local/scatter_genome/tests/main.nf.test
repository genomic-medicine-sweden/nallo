nextflow_workflow {

    name "Test Workflow SCATTER_GENOME"
    script "../main.nf"
    workflow "SCATTER_GENOME"
    config "./nextflow.config"

    setup {
        run("SAMTOOLS_FAIDX") {
            script "../../../../modules/nf-core/samtools/faidx/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = [[],[]]
                input[2] = false
                """
            }
        }
    }

    test("fai, [], true, []") {

        when {
            workflow {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = [[],[]]
                input[2] = true
                input[3] = 1
                """
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert snapshot(
                    workflow.out,
                    path(workflow.out.bed.get(0).get(1)).readLines(),
                    workflow.out.bed_nuclear_intervals.findAll { it[0] instanceof String }.collect { path(it[0]).readLines() },
                ).match() }
            )
        }

    }

    test("[], bed, false, 2 - with chrM in bed file") {

        when {
            workflow {
                """
                input[0] = [[],[]]
                input[1] = channel.of('''chr22\t0\t1000\nchr22\t500\t1500\nchr22\t2000\t3000\nchrM\t0\t1000''')
                    .collectFile(name: 'chr22.bed', newLine: true)
                    .map { file -> [ [ id:'chr22' ], file ] }
                input[2] = false
                input[3] = 2
                """
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert snapshot(workflow.out, path(workflow.out.bed.get(0).get(1)).readLines()).match() },
            )
        }

    }

    test("[], bed, false, 2 - with chrM in bed file - stub") {

        options "-stub"
        when {
            workflow {
                """
                input[0] = [[],[]]
                input[1] = channel.of('''chr22\t0\t1000\nchr22\t500\t1500\nchr22\t2000\t3000\nchrM\t0\t1000''')
                    .collectFile(name: 'chr22.bed', newLine: true)
                    .map { file -> [ [ id:'chr22' ], file ] }
                input[2] = false
                input[3] = 2
                """
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert snapshot(workflow.out, path(workflow.out.bed.get(0).get(1)).readLines()).match() },
            )
        }

    }
    test("[], bed, false, 2 - without chrM in bed file") {

        when {
            workflow {
                """
                input[0] = [[],[]]
                input[1] = channel.of('''chr22\t0\t1000\nchr22\t500\t1500\nchr22\t2000\t3000\n''')
                    .collectFile(name: 'chr22.bed', newLine: true)
                    .map { file -> [ [ id:'chr22' ], file ] }
                input[2] = false
                input[3] = 2
                """
            }
        }

        then {
            // Should we assert that the mt bed is empty?
            assertAll (
                { assert workflow.success },
                { assert path(workflow.out.bed_mitochondrial.get(0).get(1)).size() == 0 },
                { assert snapshot(workflow.out, path(workflow.out.bed.get(0).get(1)).readLines()).match() },
            )
        }

    }

    test("[], bed, false, 5 - should fail due to too few intervals in bed file") {

        when {
            workflow {
                """
                input[0] = [[],[]]
                input[1] = channel.of('''chr22\t0\t1000\nchr22\t500\t1500\nchr22\t2000\t3000''')
                    .collectFile(name: 'chr22.bed', newLine: true)
                    .map { file -> [ [ id:'chr22' ], file ] }
                input[2] = false
                input[3] = 5
                """
            }
        }

        then {
            assertAll (
                { assert workflow.failed },
                { assert workflow.errorMessage.contains("Expected 5, but got 2 files from splitting the BED file. This can happen if the input BED file (or fasta file if not using BED) has too few regions to split into 5 parts. Please check the input files or set `--snv_calling_processes` to 2.") },
            )
        }

    }
}
