nextflow_workflow {

    name "Test Workflow ANNOTATE_METHYLATION"
    script "../main.nf"
    config "./nextflow.config"
    workflow "ANNOTATE_METHYLATION"

    test("methbat - 1 sample") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'test', family_id:'FAM' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_methbat_profile_regions.tsv', checkIfExists: true)
                    ]
                )
                input[1] = channel.empty()
                input[2] = channel.of([
                    [ id:'methbat_regions' ],
                    file(params.pipelines_testdata_base_path + 'reference/methbat_regions.tsv', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [ id:'methbat_map' ],
                    file(params.pipelines_testdata_base_path + 'reference/methbat_map.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            // One table per family and caller, in any order; rows as coordinates, cpg_label, sample_id and the map columns
            def tables = workflow.out.methylation_annotation.collect { meta, tsv ->
                [ meta, file(tsv).name, path(tsv).md5, file(tsv).readLines().collect { line -> line.split('\t', -1).with { cols -> (cols[0..4] + cols[-3..-1]).join('\t') } } ]
            }.sort { table -> table[1] }
            assertAll(
                { assert workflow.success },
                { assert snapshot(tables).match() }
            )
        }
    }

