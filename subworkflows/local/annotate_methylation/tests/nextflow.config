process {
    // One row per region and label (cpg_label or region_label column, else empty), HGNC:NA labels dropped
    withName: 'ANNOTATE_METHYLATION:GAWK_REGION_LABELS' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = [
            '\'BEGIN { print "chrom", "start", "end", "cpg_label" }',
            '{ sub(/\\r$/, "") }',
            'FNR == 1 && $1 == "chrom" { for (i = 4; i <= NF; i++) if ($i == "cpg_label" || $i == "region_label") label = i; next }',
            '{ name = label ? $label : ""; if (name ~ /HGNC:NA/) next; row = $1 OFS $2 OFS $3 OFS name; if (!(row in seen)) { seen[row] = 1; print row } }\'',
        ].join(' ')
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}_region_labels" }
    }

    // The same rows with the map columns: a label with HGNC:<id> gets the map row with the same coordinates and id,
    // a row without id gets every map row at its coordinates, a row without map row gets empty map columns.
    // Input order: region file, then map.
    withName: 'ANNOTATE_METHYLATION:GAWK_REGION_GENES' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = [
            '\'{ sub(/\\r$/, "") }',
            'FILENAME == ARGV[1] && FNR == 1 && $1 == "chrom" { for (i = 4; i <= NF; i++) if ($i == "cpg_label" || $i == "region_label") label = i; next }',
            'FILENAME == ARGV[1] { name = label ? $label : ""; if (name ~ /HGNC:NA/) next; row = $1 OFS $2 OFS $3 OFS name; if (row in seen) next; seen[row] = 1; n++; rows[n] = row; coords[n] = $1 OFS $2 OFS $3; ids[n] = match(name, /HGNC:([0-9]+)/, m) ? m[1] : ""; next }',
            'FNR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; header = "chrom" OFS "start" OFS "end" OFS "cpg_label"; for (i = 1; i <= NF; i++) if ($i != "chrom" && $i != "start" && $i != "end") { header = header OFS $i; none = none OFS; keep[++k] = i }; print header; next }',
            '{ c = $col["chrom"] OFS $col["start"] OFS $col["end"]; id = ("hgnc_id" in col) ? $col["hgnc_id"] : ""; sub(/^HGNC:/, "", id); genes = ""; for (j = 1; j <= k; j++) genes = genes OFS $keep[j]; nmap[c]++; map_id[c, nmap[c]] = id; map_genes[c, nmap[c]] = genes }',
            'END { for (i = 1; i <= n; i++) { found = 0; for (j = 1; j <= nmap[coords[i]]; j++) if (ids[i] == "" || ids[i] == map_id[coords[i], j]) { print rows[i] map_genes[coords[i], j]; found = 1 }; if (!found) print rows[i] none } }\'',
        ].join(' ')
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}_region_genes" }
    }

    // Drops the region name (column 4: methbat cpg_label, modkit name) and comment lines; the dmr #chrom header becomes chrom
    withName: 'ANNOTATE_METHYLATION:GAWK_REGION_VALUES' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = '\'/^#chrom\\t/ { sub(/^#/, "") } /^#/ { next } { sub(/\\r$/, ""); out = $1; for (i = 2; i <= NF; i++) if (i != 4) out = out OFS $i; print out }\''
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}_${meta.methylation_caller}_region_values" }
    }

    withName: 'ANNOTATE_METHYLATION:CSVTK_JOIN_REGION_LABELS' {
        ext.prefix = { "${meta.id}_${meta.methylation_caller}_with_region_labels" }
        ext.args   = {
            [
                "--tabs",
                "--out-tabs",
                "--fields chrom,start,end",
                "--keep-unmatched",
            ].join(' ')
        }
    }

    withName: 'ANNOTATE_METHYLATION:CSVTK_MUTATE2' {
        ext.prefix = { "${meta.id}_${meta.methylation_caller}_with_sample_id" }
        ext.args   = {
            [
                "--after cpg_label",
                "--name sample_id",
                "--expression \"\'${meta.id}\'\"",
            ].join(' ')
        }
    }

    withName: 'ANNOTATE_METHYLATION:CSVTK_JOIN_REGION_GENES' {
        ext.prefix = { "${meta.id}_${meta.methylation_caller}_with_hgnc_and_region_type" }
        ext.args   = {
            [
                "--tabs",
                "--out-tabs",
                "--fields chrom,start,end,cpg_label",
                "--keep-unmatched",
            ].join(' ')
        }
    }

    withName: 'ANNOTATE_METHYLATION:CSVTK_CONCAT' {
        ext.prefix = { "${meta.id}_${meta.methylation_caller}_concat_per_family" }
    }

    withName: 'ANNOTATE_METHYLATION:CSVTK_SORT' {
        ext.prefix = { "${meta.id}_${meta.methylation_caller == 'modkit' ? 'modkit_dmr' : 'methbat_profile'}_annotated" }
        ext.args   = {
            [
                "--keys sample_id:N",
                "--keys chrom:N",
                "--keys start:n",
            ].join(' ')
        }
    }
}
