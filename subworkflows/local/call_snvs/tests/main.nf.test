                    [ id:'genome'],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome'],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[3] = [[],[]]
                input[4] = channel.of([
                    [ id:'sentieon_model_bundle' ],
                    file(params.pipelines_testdata_base_path + 'reference/expected_cn.hg38.XX.bed', checkIfExists: true)
                ])
                input[5] = channel.of([
                    [ id:'female_diploid_bed' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.bed', checkIfExists: true)
                ])
                input[6] = channel.of([
                    [ id:'male_diploid_bed' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.bed', checkIfExists: true)
                ])
                input[7] = channel.of([
                    [ id:'male_haploid_bed' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.blacklist_intervals.bed', checkIfExists: true)
                ])
                // Mock population resources: only staging is exercised in stub mode.
                input[8] = [
                    [ id:'population_vcf' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true)
                ]
                input[9] = [
                    [ id:'population_tbi' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true)
                ]
                input[10] = "sentieon"
                input[11] = "HiFi"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.vcf.size() == 1 },
                { assert workflow.out.index.size() == 1 },
                { assert workflow.out.gvcf.size() == 1 },
                { assert workflow.out.gvcf_index.size() == 1 },
                { assert file(workflow.out.vcf.get(0).get(1)).name == 'test_ploidyfix.vcf.gz' },
                { assert file(workflow.out.index.get(0).get(1)).name == 'test_ploidyfix.vcf.gz.tbi' },
                { assert file(workflow.out.gvcf.get(0).get(1)).name == 'test_test_genome.multi_intervals.bed_diploid.bed_sentieon.g.vcf.gz' },
                { assert file(workflow.out.gvcf_index.get(0).get(1)).name == 'test_test_genome.multi_intervals.bed_diploid.bed_sentieon.g.vcf.gz.tbi' }
            )
        }

    }

}
