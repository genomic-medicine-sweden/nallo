nextflow_workflow {

    name "Test Workflow PORTELLO"
    script "../main.nf"
    workflow "PORTELLO"
    config "./nextflow.config"

    setup {
        run("PREPARE_REFERENCES") {
            script "../../prepare_references/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'hg38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome3.fasta', checkIfExists: true),
                ])
                input[1] = []
                input[2] = channel.of([
                    [ id: 'vep_cache' ],
                    file(params.pipelines_testdata_base_path + 'reference/vep_cache_test_data.tar.gz', checkIfExists:true)
                ])
                input[3] = false
                input[4] = false
                """
            }
        }
    }

    test("1 sample") {
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_to_assembly.bam'),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_to_assembly.bam.bai'),
                ])
                input[1] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam'),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam.bai'),
                ])
                input[2] = PREPARE_REFERENCES.out.fasta
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out.bam.get(0).get(1)).getReadsMD5(),
                    file(workflow.out.bai.get(0).get(1)).name
                ).match() }
            )
        }
    }

    test("1 sample - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_to_assembly.bam'),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_to_assembly.bam.bai'),
                ])
                input[1] = Channel.of([
                    [ id: 'HG002', sex: 1 ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam'),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam.bai'),
                ])
                input[2] = PREPARE_REFERENCES.out.fasta
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
