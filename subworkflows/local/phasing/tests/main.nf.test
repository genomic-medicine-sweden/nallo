    test("2 samples - SNVs only - Longphase - bam output") {

        when {
            workflow {
                """
                input[0] = BCFTOOLS_MERGE.out.vcf
                input[1] = BCFTOOLS_MERGE.out.index
                input[2] = channel.empty() // SV VCF
                input[3] = channel.empty() // SV VCF index
                input[4] = channel.of(
                    [
                        [ id : 'HG002', family_id: 'FAM' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG002_PacBio_Revio.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id : 'HG003', family_id: 'FAM' ],
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'testdata/HG003_PacBio_Revio.bam.bai', checkIfExists: true)
                    ]
                )
                input[5] = channel.of([ [ id: 'FAM' ], [ 'HG002', 'HG003' ] ])
                input[6] = GUNZIP.out.gunzip
                input[7] = SAMTOOLS_FAIDX.out.fai
                input[8] = 'longphase'
                input[9] = false // phase_with_svs — SVs passed through unchanged
                input[10] = false // cram_output
                input[11] = channel.of([ [ id: 'FAM' ], [] ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.phased_family_snvs.collect { meta, vcf -> [ meta, file(vcf).name, path(vcf).vcf.summary, path(vcf).vcf.variantsMD5 ] },
                    file(workflow.out.phased_family_snvs_tbi.get(0).get(1)).name,
                    workflow.out.phased_family_svs,
                    workflow.out.phased_family_svs_tbi,
                    workflow.out.haplotagged_bam_bai,
                    workflow.out.haplotagged_cram_crai,
                    workflow.out.stats,
                    workflow.out.blocks,
                    workflow.out.blocks_index,
                    workflow.out.haplotagging_stats.collect { meta, stats -> [meta, file(stats).name, path(stats).readLines()[0..12].join('\n').md5()] },
                    workflow.out.haplotagging_arrow.collect { meta, arrow -> [meta, file(arrow).name] }
