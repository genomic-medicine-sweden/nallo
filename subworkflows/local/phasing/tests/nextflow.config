process {

    withName: 'BCFTOOLS_MERGE' {
        ext.args = [
            '--output-type z',
            '--write-index=tbi',
            '--no-version'
        ].join(' ')
    }
    withName: 'PHASING:LONGPHASE:BCFTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_phased_${meta.variant_type}" }
        ext.args = [
            '--output-type z',
            '--write-index=tbi',
            '--no-version',
            '--force-single'
        ].join(' ')
    }
    withName: 'PHASING:LONGPHASE:SPLIT_MULTISAMPLE_VCF:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}.${meta.variant_type}" }
        ext.args = {[
            '--output-type z',
            '--no-version',
            "--samples ${meta.id}"
        ].join(' ') }
    }
}
