process {

    withName: BCFTOOLS_MERGE {
        ext.args = ['--output-type z', '--write-index=tbi', '--no-version'].join(' ')
    }
    withName: 'PHASING:LONGPHASE:SPLIT_MULTISAMPLE_VCF:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_bcftools_view" }
        ext.args   = {
            ['--output-type z', '--no-version', "--samples ${meta.id}"].join(' ')
        }
    }

    withName: 'PHASING:LONGPHASE:BCFTOOLS_INDEX' {
        ext.args = '--tbi'
    }

    withName: 'PHASING:LONGPHASE:BCFTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_bcftools_merge" }
        ext.args   = ['--force-single', '--output-type z', '--write-index=tbi', '--no-version'].join(' ')
    }

    withName: 'PHASING:LONGPHASE:LONGPHASE_PHASE' {
        ext.prefix = { "${meta.id}_longphase_phase" }
        ext.args   = "--pb"
    }

    withName: 'PHASING:LONGPHASE:LONGPHASE_HAPLOTAG' {
        ext.prefix = { "${meta.id}_longphase_haplotag" }
    }

    withName: 'PHASING:HIPHASE:RUN_HIPHASE' {
        ext.prefix = { "${meta.id}_hiphase" }
        ext.args   = {
            (meta.sample_ids
                .collect { id -> "--sample-name ${id}" })
                .join(' ')
        }
    }

    withName: 'PHASING:WHATSHAP:WHATSHAP_PHASE' {
        ext.prefix = { "${meta.id}_whatshap_phase" }
        ext.args   = ['--indels', '--use-supplementary'].join(' ')
    }

    withName: 'PHASING:WHATSHAP:WHATSHAP_HAPLOTAG' {
        ext.prefix = { "${meta.id}_whatshap_haplotag" }
    }

    withName: 'PHASING:QC_PHASING:BCFTOOLS_CONCAT' {
        ext.prefix = { "${meta.id}_bcftools_cocat" }
        ext.args   = ['--allow-overlaps', '--output-type z', '--write-index=tbi'].join(' ')
    }

    withName: 'PHASING:QC_PHASING:CRAMINO' {
        ext.args   = {
            [
                '--karyotype',
                '--phased',
                "--arrow ${meta.id}_cramino.arrow",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}_cramino" }
    }

    withName: 'PHASING:QC_PHASING:WHATSHAP_STATS' {
        ext.prefix = { "${meta.id}_whatshap_stats" }
        ext.args   = {
            "--sample ${meta.id}"
        }
    }
}
