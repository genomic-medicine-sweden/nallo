/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Methylation
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */

    withName: '.*:CALL_METHYLATION_MODKIT:GAWK_PILEUP_REGIONS' {
        ext.args2  = "'{print \$1\"\\t\"\$2\"\\t\"\$3}'"
        ext.suffix = 'bed'
        ext.prefix = { "${meta.id}_modkit_regions" }
    }

    withName: '.*:CALL_METHYLATION_MODKIT:MODKIT_PILEUP' {
        ext.args   = {
            [
                "${params.extra_modkit_options}",
                '--cpg',
                '--combine-strands',
                !params.skip_phasing ? '--phased' : '',
                "--modified-bases ${params.modkit_modified_bases}",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}_modkit_pileup" }
    }


    withName: '.*:CALL_METHYLATION_MODKIT:TABIX_TABIX' {
        ext.prefix = { "${input.simpleName}" }
    }

    withName: '.*CALL_METHYLATION_MODKIT:MODKIT_BEDMETHYLTOBIGWIG' {
        ext.prefix = { "${bedmethyl.simpleName}" }
    }

    // BED4 (chrom, start, end, label) from methylation_regions: header dropped, one row per region and label.
    // The label is cpg_label (or region_label), else chrom:start-end. Windows line endings are removed.
    withName: '.*:CALL_METHYLATION_MODKIT:GAWK_DMR_REGIONS' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = '\'{ sub(/\\r$/, "") } NR == 1 && $1 == "chrom" { for (i = 4; i <= NF; i++) if ($i == "cpg_label" || $i == "region_label") label = i; next } { name = label ? $label : $1 ":" $2 "-" $3; row = $1 OFS $2 OFS $3 OFS name; if (!(row in seen)) { seen[row] = 1; print row } }\''
        ext.suffix = 'bed'
        ext.prefix = { "${meta.id}_dmr_regions" }
    }

    withName: '.*:CALL_METHYLATION_MODKIT:MODKIT_DMR' {
        ext.args   = '--base C --header'
        ext.prefix = { "${meta.id}_modkit_dmr_hp1_vs_hp2" }
    }
}
