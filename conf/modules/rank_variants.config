/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional clause
----------------------------------------------------------------------------------------
*/

process {

    //
    // Score and rank SNVs and SVs.
    //
    withName: '.*:RANK_VARIANTS:.*' {
        publishDir = [
            enabled: false
        ]
        tag = { "${meta.id}_${meta.set}" }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_annotate" }
        ext.args = {
            [
                '--annotate_regions',
                '--genome-build 38',
                '--temp_dir ./',
            ].join(' ')
        }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_models" }
        ext.args = { [
            "--temp_dir ./"
        ].join(' ') }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_score" }
        ext.args = "--rank_results"
    }
    withName: '.*:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_compound" }
        ext.args = {
            [
                "--threshold ${meta.child_with_two_parents_in_family ? (meta.variant_type == 'snv' ? params.genmod_compound_trio_snv_threshold : params.genmod_compound_trio_sv_threshold) : (meta.variant_type == 'snv' ? params.genmod_compound_singleton_snv_threshold : params.genmod_compound_singleton_sv_threshold)}",
                "--penalty ${meta.child_with_two_parents_in_family ? (meta.variant_type == 'snv' ? params.genmod_compound_trio_snv_penalty : params.genmod_compound_trio_sv_penalty) : (meta.variant_type == 'snv' ? params.genmod_compound_singleton_snv_penalty : params.genmod_compound_singleton_sv_penalty)}",
                "--temp_dir ./",
            ].join(' ')
        }
    }
    withName: '.*:RANK_VARIANTS:BCFTOOLS_SORT' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_ranked_sorted" }
        ext.args = [
            '--output-type z',
            '--write-index=tbi',
            '--max-mem 5G',
        ].join(' ')
    }
}
