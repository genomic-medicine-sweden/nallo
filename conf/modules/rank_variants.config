/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional clause
----------------------------------------------------------------------------------------
*/

process {

    //
    // Score and rank SNVs and SVs.
    //
    withName: '.*:RANK_VARIANTS:.*' {
        tag = { "${meta.id}_${meta.set}" }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_annotate" }
        ext.args = {
            [
                '--annotate_regions',
                '--genome-build 38',
                '--temp_dir ./',
            ].join(' ')
        }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_models" }
        ext.args = { [
            "--temp_dir ./"
        ].join(' ') }
    }
    withName: '.*:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_score" }
        ext.args = "--rank_results"
    }
    withName: '.*:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_genmod_compound" }
        ext.args = {
            def scenario = meta.child_with_two_parents_in_family ? 'trio' : 'singleton'
            def type = meta.variant_type // 'snv' or 'sv'

            def thresholds = [
                snv: [trio: params.genmod_compound_trio_snv_threshold, singleton: params.genmod_compound_singleton_snv_threshold],
                sv : [trio: params.genmod_compound_trio_sv_threshold, singleton: params.genmod_compound_singleton_sv_threshold]
            ]

            def penalties = [
                snv: [trio: params.genmod_compound_trio_snv_penalty, singleton: params.genmod_compound_singleton_snv_penalty],
                sv : [trio: params.genmod_compound_trio_sv_penalty, singleton: params.genmod_compound_singleton_sv_penalty]
            ]

            [
                "--threshold ${thresholds[type][scenario]}",
                "--penalty ${penalties[type][scenario]}",
                "--temp_dir ./"
            ].join(' ')
        }
    }
    withName: '.*:RANK_VARIANTS:BCFTOOLS_SORT' {
        ext.prefix = { "${meta.id}_${meta.variant_type}_ranked_sorted" }
        ext.args = [
            '--output-type z',
            '--write-index=tbi',
            '--max-mem 6G',
        ].join(' ')
    }
}
