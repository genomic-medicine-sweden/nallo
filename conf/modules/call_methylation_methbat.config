/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Methylation
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */

    withName: '.*CALL_METHYLATION_METHBAT:PBCPGTOOLS_ALIGNEDBAMTOCPGSCORES' {
        ext.prefix = { "${meta.id}_pbcpgtools" }
    }

    // One row per region (and data_category in background models): label column set to chrom:start-end, Windows line endings removed
    withName: '.*:CALL_METHYLATION_METHBAT:GAWK_METHBAT_REGIONS' {
        ext.args   = '-F\'\\t\' -v OFS=\'\\t\''
        ext.args2  = [
            '\'{ sub(/\\r$/, "") }',
            'FNR == 1 && $1 == "chrom" { for (i = 4; i <= NF; i++) { if ($i == "cpg_label" || $i == "region_label") label = i; if ($i == "data_category") category = i }; print; next }',
            '{ key = $1 OFS $2 OFS $3 OFS (category ? $category : ""); if (key in seen) next; seen[key] = 1; if (label) $label = $1 ":" $2 "-" $3; print }\'',
        ].join(' ')
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}_methbat_regions" }
    }

    withName: '.*:CALL_METHYLATION_METHBAT:METHBAT_PROFILE' {
        ext.args   = {
            ["${params.extra_methbat_profile_options}", "--profile-label", meta.sex == 1 ? params.methbat_male_label : params.methbat_female_label].join(" ")
        }
        ext.prefix = { "${meta.id}_methbat_profile" }
    }
}
