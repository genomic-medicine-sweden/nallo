process {

    withName: '.*:PHASING:QC_PHASING:BCFTOOLS_CONCAT' {
        ext.prefix = { "${meta.id}_phased"}
        ext.args = [
            '--allow-overlaps',
            '--output-type z',
            '--write-index=tbi'
        ].join(' ')
    }

    withName: '.*:PHASING:QC_PHASING:CRAMINO' {
        ext.args = {
            [
                '--karyotype',
                '--phased',
                "--arrow ${meta.id}_cramino_aligned_phased.arrow",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}_cramino_aligned_phased" }
    }

    withName: '.*:PHASING:QC_PHASING:WHATSHAP_STATS' {
        ext.prefix = { "${meta.id}_whatshap_stats" }
        ext.args   = {
            "--sample ${meta.id}"
        }
    }

    withName: '.*:PHASING:QC_PHASING:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}_whatshap_stats" }
    }
}
