process {
    withName: '.*:KIVVI:BCFTOOLS_SORT' {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}_kivvi_sorted" }
    }
    withName: '.*:KIVVI:BCFTOOLS_MERGE' {
        ext.args   = '--output-type z --write-index=tbi --force-single'
        ext.prefix = { "${meta.id}_kivvi_merged" }
    }
    withName: '.*:KIVVI:MERGE_JSON' {
        ext.prefix = { "${meta.id}_kivvi_merged" }
    }
}
