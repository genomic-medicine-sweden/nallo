/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNV Annotation
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:ANNOTATE_SNVS:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_filtered" }
        // Drop spanning deletion ("*") alleles from Sentieon.
        // They are redundant (covered by upstream DELs) and break VEP annotation,
        // causing downstream MSC/PLI scripts to crash.
        ext.args   = {
            ['--output-type z', '--write-index=tbi', "${params.pre_vep_snv_filter_expression}", params.snv_caller == 'sentieon' ? '-e \'ALT="*"\'' : ''].join(" ")
        }
    }

    withName: '.*:ANNOTATE_SNVS:ECHTVAR_ANNO' {
        ext.prefix = { "${meta.id}_echtvar_anno" }
    }

    withName: '.*:ANNOTATE_SNVS:TABIX_TABIX' {
        ext.prefix = { "${meta.id}_unfiltered" }
    }

    withName: '.*:ANNOTATE_SNVS:ENSEMBLVEP_SNV' {
        ext.prefix = { "${meta.id}_vep" }
        ext.args   = {
            def distance = meta.genome == 'mitochondrial' ? "--distance ${params.vep_mitochondrial_genome_distance}" : "--distance ${params.vep_nuclear_genome_distance}"
            [
                '--dir_plugins .',
                '--plugin LoFtool,LoFtool_scores.txt',
                '--plugin pLI,pLI_values.txt',
                distance,
                '--format vcf',
                '--cache',
                '--compress_output bgzip',
                '--offline',
                '--vcf',
                "${params.extra_vep_options_snv}",
            ].join(' ')
        }
    }
}
