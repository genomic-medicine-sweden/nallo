/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Call SVs
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:CALL_SVS:SNIFFLES_SV:RUN_SNIFFLES' {
        ext.prefix = { "${meta.id}_sniffles_for_reheader" }
        ext.args   = {
            ["--minsupport ${params.sniffles_min_support_reads}", "--min-alignment-length ${params.sniffles_min_segment_length}", "--minsvlen ${params.sniffles_min_sv_size}"].join(' ')
        }
    }

    withName: '.*:CALL_SVS:SNIFFLES1_SV:RUN_SNIFFLES1' {
        ext.prefix = { "${meta.id}_sniffles1_for_reheader" }
        ext.args   = {
            ['--cluster', '--genotype', '--ignore_sd', '--report_str', "--min_support ${params.sniffles_min_support_reads}", "--min_seq_size ${params.sniffles_min_segment_length}", "--min_length ${params.sniffles_min_sv_size}", "--min_het_af ${params.sniffles_min_heterozygous_allele_frequency}"].join(' ')
        }
    }

    withName: '.*:CALL_SVS:SEVERUS_SV:RUN_SEVERUS' {
        ext.prefix = { "${meta.id}_severus" }
    }

    withName: '.*:CALL_SVS:DEBREAK_SV:RUN_DEBREAK' {
        ext.prefix = { "${meta.id}_debreak_for_reheader" }
    }

    withName: '.*:CALL_SVS:HIFICNV_SV:RUN_HIFICNV' {
        ext.prefix = { "${meta.id}_hificnv" }
    }

    withName: '.*:CALL_SVS:HIFICNV_SV:TABIX_HIFICNV' {
        ext.prefix = { "${meta.id}_tabix_hificnv" }
    }

    withName: '.*:CALL_SVS:SAWFISH_SV:RUN_SAWFISH_DISCOVER' {
        ext.prefix = { "${meta.id}_sawfish_discover" }
        ext.args   = {
            ["${params.extra_sawfish_options}", "--min-indel-size ${params.sawfish_min_sv_size}"].join(' ')
        }
    }

    withName: '.*:CALL_SVS:SAWFISH_SV:RUN_SAWFISH_JOINTCALL' {
        ext.prefix = { "${meta.id}_sawfish_sv" }
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SV post-processing (VEP prep, sort, region filter) — run in nallo.nf after CALL_SVS
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:NALLO:VEP_PREP_SV' {
        ext.prefix = { "${meta.id}_vep_prep" }
        ext.args   = { meta.sv_caller == 'sniffles1' ? '--caller sniffles1' : '' }
    }

    withName: '.*:NALLO:BCFTOOLS_SORT_SVS' {
        ext.args = ['--output-type z', '--write-index=tbi'].join(' ')
    }

    withName: '.*:NALLO:BCFTOOLS_VIEW_SVS' {
        ext.prefix = { "${meta.id}_${meta.sv_caller}_filtered" }
        ext.args   = ['--output-type z', '--write-index=tbi'].join(' ')
    }
}
