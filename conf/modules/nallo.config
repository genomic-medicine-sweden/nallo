/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process in main workflow
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:NALLO:BCFTOOLS_VIEW_CHROMOGRAPH' {
        ext.args = {
            [
                "--output-type z",
                "--write-index=tbi",
                "--min-ac 1",
                "--samples ${meta.id}",
            ].join(' ')
        }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:BCFTOOLS_CONCAT' {
        ext.prefix = { "${meta.id}_concat" }
        ext.args = {
            [
                '--allow-overlaps',
                '--output-type u',
            ].join(' ')
        }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:BCFTOOLS_CONCAT_PHASING' {
        ext.prefix = { "${meta.id}_concat" }
        ext.args = {
            [
                '--output-type z',
                '--write-index=tbi',
                '--allow-overlaps',
            ].join(' ')
        }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:BCFTOOLS_VIEW_PHASING' {
        ext.prefix = { "${meta.id}_${meta.family_id}" }
        ext.args = {
            [
                '--output-type z',
                '--write-index=tbi',
            ].join(' ')
        }
        publishDir = [
            enabled: false
        ]
    }

    // Output family SVs from here
    withName: '.*:NALLO:BCFTOOLS_VIEW_SV' {
        ext.prefix = {
            def name = []
            name << "${meta.id}_svs"
            if (!params.skip_sv_annotation) {
                name << "annotated"
            }
            if (!params.skip_rank_variants) {
                name << "ranked"
            }
            if (meta?.containsKey('set')) {
                name << "${meta.set}"
            }
            return name.join('_')
        }
        ext.args = {
            [
                '--output-type z',
                '--write-index=tbi',
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/svs/family/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:NALLO:FIND_CONCATENATE' {
        publishDir = [
           enabled: false
        ]
    }

    withName: '.*:NALLO:PEDDY' {
        ext.args = { !params.peddy_sites ? '--sites hg38' : '' }
        publishDir = [
            path: { "${params.outdir}/qc/peddy/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:NALLO:SAMPLESHEET_PED' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:SOMALIER_PED_FAMILY' {
        publishDir = [
            path: { "${params.outdir}/pedigree/family/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:NALLO:SPLITUBAM' {
        ext.args = { "--split ${params.alignment_processes}" }
        publishDir = [
            enabled: false
        ]
    }

    // ext.prefix: Samtools will not sort supplementary reads properly. To snapshot the md5sum,
    // they must be input in the same order and can therefore not be named the same
    withName: '.*:NALLO:MINIMAP2_ALIGN' {
        ext.prefix = { "${reads}" }
        ext.args = {
            [
                "-y",
                "-x ${params.minimap2_read_mapping_preset}",
                "--secondary=no",
                "-Y",
                "-R @RG\\\\tID:${meta.id}\\\\tSM:${meta.id}",
                "--MD",
            ].join(' ')
        }
        ext.args3 = {
            [
                '-x HP,PS',
                '-x AS,CC,CG,CP,H1,H2,HI,H0,IH,MC,MD,MQ,NM,SA,TS',
                '--no-RG',
            ].join(' ')
        }
        ext.args4 = '-T \\*'
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:MINIMAP2_ASSEMBLIES' {
        ext.prefix = { "${meta.id}_aligned_assembly"}//_haplotype_${meta.haplotype}" }
        ext.args = {
            [
                "-L",
                "--secondary=no",
                "-a",
                "--eqx",
                "-x asm5",
                "-R @RG\\\\tID:${meta.id}_hifiasm\\\\tSM:${meta.id}",
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/assembly/sample/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:NALLO:MINIMAP2_INDEX' {
        publishDir = [
           enabled: false
        ]
    }

    withName: '.*:NALLO:PBMM2_ALIGN' {
        ext.prefix = { "${meta.id}_aligned_to_assembly" }
        ext.args = {
            [
                "--sort",
                "--preset HIFI",
                "--unmapped",
            ].join(' ')
        }
        ext.args2 = {
            [
                '-x HP,PS',
                '-x AS,CC,CG,CP,H1,H2,HI,H0,IH,MC,MD,MQ,NM,SA,TS',
                '--no-RG',
            ].join(' ')
        }
        ext.args3 = '-T \\*'
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:NALLO:SAMTOOLS_INDEX_PBMM2' {
        ext.prefix = { "${meta.id}_aligned_to_assembly" }
        publishDir = [
           enabled: false
        ]
    }

    withName: '.*:NALLO:PORTELLO' {
        ext.prefix = { "${meta.id}_remapped_assembly_no_tag" }
        publishDir = [
           enabled: false
        ]
    }


    withName: '.*:NALLO:SAMTOOLS_MERGE' {
        ext.args = '--write-index'
        ext.prefix = { "${meta.id}_aligned" }
        publishDir = [
            path: { "${params.outdir}/aligned_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || !params.skip_phasing || params.alignment_output_format == 'cram' ? null : filename },
        ]
    }

    withName: '.*:NALLO:SAMTOOLS_CONVERT' {
        ext.prefix = { "${meta.id}_aligned" }
        ext.args = '--write-index'
        publishDir = [
            path: { "${params.outdir}/aligned_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SAMTOOLS_SORT_PORTELLO' {
        ext.prefix = { "${meta.id}_remapped_assembly_sorted" }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:SAMTOOLS_ADDREPLACERG' {
        ext.prefix = { "${meta.id}_remapped_assembly_rg" }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:SAMTOOLS_CALMD' {
        ext.prefix = { "${meta.id}_remapped_assembly_md" }
        ext.args = '-b '
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:GATK4_CLEANSAM' {
        ext.prefix = { "${meta.id}_remapped_assembly" }
        publishDir = [
            path: { "${params.outdir}/assembly/sample/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SAMTOOLS_INDEX_CLEANSAM' {
        ext.prefix = { "${meta.id}_remapped_assembly" }
        publishDir = [
            path: { "${params.outdir}/assembly/sample/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Summary
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml',
        ]
    }
}
