process {

    withName: '.*:PHASING:LONGPHASE:BCFTOOLS_INDEX' {
        ext.args = '--tbi'
    }

    withName: '.*:PHASING:LONGPHASE:BCFTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_phased_${meta.variant_type}" }
        ext.args   = ['--force-single', '--output-type z', '--write-index=tbi'].join(' ')
    }

    withName: '.*:PHASING:LONGPHASE:LONGPHASE_PHASE' {
        ext.prefix = { "${meta.id}_longphase" }
        ext.args   = {
            [params.preset in ['ONT_R10', 'ONT_R10_AS'] ? "--ont" : "--pb", '--indels'].join(' ')
        }
    }

    withName: '.*:PHASING:LONGPHASE:LONGPHASE_HAPLOTAG' {
        ext.prefix = { "${meta.id}_haplotagged" }
    }
}
